require "shellwords"

default_platform(:ios)

# Phase 1 model: one whitelabeled build per client (see the PRD's
# ARCHITECTURE-MAP Decision 2). Defaults below are Tom's Produce, the only
# client provisioned so far.
DEFAULT_CLIENT = {
  client_id: "c40569c6-1324-47a9-979f-6d076c4b67fc",
  slug: "toms-produce",
  bundle_id: "ca.shawcliffe.tomsproduce",
  app_name: "Tom's Produce",
}.freeze

# NOTE: these must be passed to xcodebuild as command-line build-setting
# overrides (`KEY=value` args) — shell ENV vars of the same name are NOT
# picked up by xcodebuild's build-setting resolution, so CLIENT_ID/
# CLIENT_SLUG/CLIENT_BUNDLE_ID/CLIENT_APP_NAME must flow through here, not ENV.
def client_build_settings(options)
  {
    "CLIENT_ID" => options[:client_id] || DEFAULT_CLIENT[:client_id],
    "CLIENT_SLUG" => options[:slug] || DEFAULT_CLIENT[:slug],
    "CLIENT_BUNDLE_ID" => options[:bundle_id] || DEFAULT_CLIENT[:bundle_id],
    "CLIENT_APP_NAME" => options[:app_name] || DEFAULT_CLIENT[:app_name],
  }
end

platform :ios do
  desc "Build for the iOS Simulator — no code signing needed. Params: client_id:, slug:, bundle_id:, app_name:"
  lane :build_simulator do |options|
    settings = client_build_settings(options)
    overrides = settings.map { |k, v| "#{k}=#{v.shellescape}" }.join(" ")
    sh(
      "xcodebuild -project ShawcliffeCustomer.xcodeproj -scheme ShawcliffeCustomer " \
      "-sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build #{overrides}",
      chdir: ".."
    )
  end

  desc "Build a signed, distributable per-client IPA. Same params as build_simulator. " \
       "NOT yet usable — needs a configured Apple Developer Organization account " \
       "and code signing (certs/provisioning profiles), both blocked on D-U-N-S verification."
  lane :build do |options|
    settings = client_build_settings(options)
    build_app(
      project: "ShawcliffeCustomer.xcodeproj",
      scheme: "ShawcliffeCustomer",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "#{settings['CLIENT_SLUG']}.ipa",
      xcargs: settings.map { |k, v| "#{k}=#{v.shellescape}" }.join(" ")
    )
  end
end
