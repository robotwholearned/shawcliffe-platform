# App Store Connect API key for `fastlane demo_testflight`.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Fastlane auto-loads fastlane/.env — you do NOT export these yourself.
#
# Get them from App Store Connect → Users and Access → Integrations →
# App Store Connect API (you need Admin/App Manager access):
#   • Key ID    — shown next to the key you created (e.g. 2X9R4HXF34)
#   • Issuer ID — the UUID at the top of that page (same for all keys)
#   • The .p8   — downloadable ONCE when the key is created; save it and
#                 point ASC_KEY_FILEPATH at it (path is relative to
#                 platform/ios-customer/). Keep it out of git.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=fastlane/AuthKey_XXXXXXXXXX.p8
