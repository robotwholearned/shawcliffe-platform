# Supabase — Canada region (ca-central-1)
# Create project at https://supabase.com → New Project → Region: Canada (Central)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Platform config
NEXT_PUBLIC_BASE_DOMAIN=shawcliffedigital.com
# For local dev, leave BASE_DOMAIN unset — slug routing uses /[slug] path directly

# Resend (email broadcasts)
RESEND_API_KEY=re_your_key_here

# Twilio master account (used by de-provisioning script to suspend subaccounts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Cloudflare for SaaS — per-client custom domain TLS (Tier 2). Create an API
# token at dash.cloudflare.com/profile/api-tokens with Zone > SSL and
# Certificates > Edit + Zone > Custom Hostnames > Edit, scoped to the
# shawcliffedigital.com zone. Requires Cloudflare for SaaS enabled on the zone
# and a Fallback Origin configured once (Cloudflare dashboard → SSL/TLS →
# Custom Hostnames → Fallback Origin) pointing at shawcliffe-platform.onrender.com.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# APNs push (push broadcasts) — one key covers every client's app under
# Shawcliffe's single Apple Developer account. Generate at
# developer.apple.com → Certificates, Identifiers & Profiles → Keys → (+),
# enable "Apple Push Notifications service (APNs)". Requires a paid Apple
# Developer Program membership. Sandbox vs production is tracked per device
# token now (push_tokens.environment), not by a single server-wide setting.
APNS_TEAM_ID=your_apple_team_id
APNS_KEY_ID=your_apns_key_id
# Contents of the downloaded .p8 file, with real newlines replaced by \n
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_DEFAULT_TOPIC=ca.shawcliffe.tomsproduce

# FCM (Android push) — single Firebase project initially (see PRD ADR 2).
# Create a project at console.firebase.google.com, add an Android app to it
# (this is also what generates google-services.json for
# platform/android-customer — doesn't exist yet, blocks Android push
# end-to-end until added), then Project Settings → Service Accounts →
# Generate new private key. Paste the entire downloaded JSON as one line.
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
